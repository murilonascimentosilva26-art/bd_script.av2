-- ==========================================
-- 0. REMOÇÃO DE TABELAS EXISTENTES (CASO NECESSÁRIO)
-- ==========================================
DROP TABLE IF EXISTS sessao_usuario CASCADE;
DROP TABLE IF EXISTS diagnostico_compatibilidade CASCADE;
DROP TABLE IF EXISTS relatorio_divergencia CASCADE;
DROP TABLE IF EXISTS consentimento_usuario CASCADE;
DROP TABLE IF EXISTS notificacao CASCADE;
DROP TABLE IF EXISTS requisito_aplicativo CASCADE;
DROP TABLE IF EXISTS dispositivo CASCADE;
DROP TABLE IF EXISTS aplicativo CASCADE;
DROP TABLE IF EXISTS termo_lgpd CASCADE;
DROP TABLE IF EXISTS usuario CASCADE;

-- Remoção dos ENUMs caso já existam
DROP TYPE IF EXISTS status_compatibilidade;
DROP TYPE IF EXISTS status_relatorio;
DROP TYPE IF EXISTS perfil_usuario;
DROP TYPE IF EXISTS tipo_requisito;

-- ==========================================
-- CRIAÇÃO DOS TIPOS ENUM
-- ==========================================
CREATE TYPE tipo_requisito AS ENUM ('MINIMO', 'RECOMENDADO');
CREATE TYPE perfil_usuario AS ENUM ('ADMIN', 'COMUM', 'DESENVOLVEDOR');
CREATE TYPE status_relatorio AS ENUM ('ABERTO', 'EM_ANALISE', 'RESOLVIDO', 'FECHADO');
CREATE TYPE status_compatibilidade AS ENUM ('COMPATIVEL', 'INCOMPATIVEL', 'ALERTA');

-- ==========================================
-- 1. TABELA: usuario
-- ==========================================
CREATE TABLE usuario (
    id_usuario SERIAL PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    senha_hash VARCHAR(255) NOT NULL,
    perfil perfil_usuario NOT NULL,
    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    atualizado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ==========================================
-- 2. TABELA: termo_lgpd
-- ==========================================
CREATE TABLE termo_lgpd (
    id_termo_lgpd SERIAL PRIMARY KEY,
    versao VARCHAR(20) NOT NULL,
    conteudo TEXT NOT NULL,
    data_publicacao TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ==========================================
-- 3. TABELA: aplicativo
-- ==========================================
CREATE TABLE aplicativo (
    id_aplicativo SERIAL PRIMARY KEY,
    nome VARCHAR(150) NOT NULL UNIQUE,
    desenvolvedora VARCHAR(100),
    descricao TEXT,
    categoria VARCHAR(50),
    fk_usuario INT REFERENCES usuario(id_usuario) ON DELETE SET NULL,
    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ==========================================
-- 4. TABELA: dispositivo
-- ==========================================
CREATE TABLE dispositivo (
    id_dispositivo SERIAL PRIMARY KEY,
    fk_usuario INT NOT NULL REFERENCES usuario(id_usuario) ON DELETE CASCADE,
    modelo VARCHAR(100) NOT NULL,
    sistema_operacional VARCHAR(50) NOT NULL,
    versao_so VARCHAR(50) NOT NULL,
    arquitetura_cpu VARCHAR(50),
    nucleos_cpu INT,
    frequencia_cpu_ghz DECIMAL(4,2),
    memoria_ram_mb INT NOT NULL,
    armazenamento_total_mb BIGINT NOT NULL,
    armazenamento_livre_mb BIGINT NOT NULL,
    coletado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ==========================================
-- 5. TABELA: requisito_aplicativo
-- ==========================================
CREATE TABLE requisito_aplicativo (
    id_requisito_aplicativo SERIAL PRIMARY KEY,
    fk_aplicativo INT NOT NULL REFERENCES aplicativo(id_aplicativo) ON DELETE CASCADE,
    tipo tipo_requisito NOT NULL,
    so_minimo VARCHAR(50) NOT NULL,
    versao_so_minima VARCHAR(50) NOT NULL,
    ram_minima_mb INT NOT NULL,
    espaco_armazenamento_mb BIGINT NOT NULL,
    frequencia_cpu_minima_ghz DECIMAL(4,2),
    nucleos_cpu_minimos INT
);

-- ==========================================
-- 6. TABELA: notificacao
-- ==========================================
CREATE TABLE notificacao (
    id_notificacao SERIAL PRIMARY KEY,
    fk_usuario INT NOT NULL REFERENCES usuario(id_usuario) ON DELETE CASCADE,
    titulo VARCHAR(150) NOT NULL,
    mensagem TEXT NOT NULL,
    lida BOOLEAN DEFAULT FALSE,
    criada_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ==========================================
-- 7. TABELA: consentimento_usuario
-- ==========================================
CREATE TABLE consentimento_usuario (
    id_consentimento_usuario SERIAL PRIMARY KEY,
    fk_usuario INT NOT NULL REFERENCES usuario(id_usuario) ON DELETE CASCADE,
    fk_termo_lgpd INT NOT NULL REFERENCES termo_lgpd(id_termo_lgpd) ON DELETE CASCADE,
    aceito BOOLEAN NOT NULL,
    data_consentimento TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ==========================================
-- 8. TABELA: relatorio_divergencia
-- ==========================================
CREATE TABLE relatorio_divergencia (
    id_relatorio_divergencia SERIAL PRIMARY KEY,
    fk_usuario INT NOT NULL REFERENCES usuario(id_usuario) ON DELETE CASCADE,
    fk_aplicativo INT NOT NULL REFERENCES aplicativo(id_aplicativo) ON DELETE CASCADE,
    fk_dispositivo INT NOT NULL REFERENCES dispositivo(id_dispositivo) ON DELETE CASCADE,
    descricao_problema TEXT NOT NULL,
    status status_relatorio,
    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ==========================================
-- 9. TABELA: diagnostico_compatibilidade
-- ==========================================
CREATE TABLE diagnostico_compatibilidade (
    id_diagnostico_compatibilidade SERIAL PRIMARY KEY,
    fk_usuario INT NOT NULL REFERENCES usuario(id_usuario) ON DELETE CASCADE,
    fk_dispositivo INT NOT NULL REFERENCES dispositivo(id_dispositivo) ON DELETE CASCADE,
    fk_aplicativo INT NOT NULL REFERENCES aplicativo(id_aplicativo) ON DELETE CASCADE,
    status status_compatibilidade NOT NULL,
    detalhes_falhas JSONB,
    executado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ==========================================
-- 10. TABELA: sessao_usuario
-- ==========================================
CREATE TABLE sessao_usuario (
    id_sessao_usuario SERIAL PRIMARY KEY,
    fk_usuario INT NOT NULL REFERENCES usuario(id_usuario) ON DELETE CASCADE,
    token_jwt VARCHAR(500) NOT NULL,
    ip_origem VARCHAR(45),
    user_agent TEXT,
    expira_em TIMESTAMP NOT NULL,
    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


